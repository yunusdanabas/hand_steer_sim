# Dockerfile.gpu

# ───────────────────────────── Builder Stage ─────────────────────────────
FROM ubuntu:20.04 AS builder
ARG ROS_DISTRO=noetic
ARG OS_CODENAME=focal
ENV DEBIAN_FRONTEND=noninteractive

# 1) Core build tools
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg2 lsb-release software-properties-common \
      python3 python3-pip python3-dev python3-distutils \
      build-essential cmake libusb-1.0-0-dev \
 && rm -rf /var/lib/apt/lists/*

# 2) Add ROS & RealSense repos, then install rosdep & catkin-tools
RUN set -eux; \
    curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
      -o /usr/share/keyrings/ros-archive-keyring.gpg; \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
      http://packages.ros.org/ros/ubuntu ${OS_CODENAME} main" \
      > /etc/apt/sources.list.d/ros.list; \
    curl -sSL https://librealsense.intel.com/Debian/librealsense.pgp \
      -o /usr/share/keyrings/librealsense-archive-keyring.gpg; \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/librealsense-archive-keyring.gpg] \
      https://librealsense.intel.com/Debian/apt-repo ${OS_CODENAME} main" \
      > /etc/apt/sources.list.d/librealsense.list; \
    apt-get update \
 && apt-get install -y --no-install-recommends python3-rosdep python3-catkin-tools \
 && rosdep init \
 && rosdep update \
 && rm -rf /var/lib/apt/lists/*

# 3) Prepare workspace & copy package
WORKDIR /catkin_ws
COPY . src/hand_steer_sim

# 4) Install only your package’s build deps
RUN apt-get update \
 && rosdep install --from-paths src/hand_steer_sim --ignore-src -r -y

# 5) Build
RUN /bin/bash -lc "source /opt/ros/${ROS_DISTRO}/setup.bash && \
    catkin_make --only-pkg-with-deps hand_steer_sim"


# ───────────────────────────── Final Stage ──────────────────────────────
FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu20.04
ARG ROS_DISTRO=noetic
ARG OS_CODENAME=focal
ENV DEBIAN_FRONTEND=noninteractive TZ=Europe/Istanbul

# 1) Runtime + Gazebo GUI + Qt + USB tools + timezone
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg2 lsb-release tzdata \
      libxkbcommon-x11-0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
      libxcb-render-util0 libxcb-util1 libxcb-sync1 libxcb-xinerama0 \
      libgl1-mesa-glx mesa-utils x11-apps \
      python3 python3-pip python3-opencv python3-pyqt5 \
      libqt5gui5 libqt5widgets5 qt5-default \
      usbutils v4l-utils \
 && rm -rf /var/lib/apt/lists/* \
 && ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime \
 && echo ${TZ} > /etc/timezone

# 2) Re-add ROS & RealSense repos
RUN set -eux; \
    curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
      -o /usr/share/keyrings/ros-archive-keyring.gpg; \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
      http://packages.ros.org/ros/ubuntu ${OS_CODENAME} main" \
      > /etc/apt/sources.list.d/ros.list; \
    curl -sSL https://librealsense.intel.com/Debian/librealsense.pgp \
      -o /usr/share/keyrings/librealsense-archive-keyring.gpg; \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/librealsense-archive-keyring.gpg] \
      https://librealsense.intel.com/Debian/apt-repo ${OS_CODENAME} main" \
      > /etc/apt/sources.list.d/librealsense.list; \
    apt-get update

# 3) Install ROS base, Gazebo & ROS tools
RUN apt-get install -y --no-install-recommends \
      ros-${ROS_DISTRO}-ros-base \
      ros-${ROS_DISTRO}-gazebo-ros-pkgs \
      ros-${ROS_DISTRO}-gazebo-ros-control \
      ros-${ROS_DISTRO}-xacro \
      ros-${ROS_DISTRO}-cv-bridge \
      ros-${ROS_DISTRO}-geometry-msgs \
      ros-${ROS_DISTRO}-rospy \
      ros-${ROS_DISTRO}-sensor-msgs \
      ros-${ROS_DISTRO}-std-msgs \
      ros-${ROS_DISTRO}-robot-state-publisher \
      ros-${ROS_DISTRO}-joint-state-publisher \
      ros-${ROS_DISTRO}-joint-state-controller \
      ros-${ROS_DISTRO}-diff-drive-controller

# 4) Copy built workspace
COPY --from=builder /catkin_ws/devel /catkin_ws/devel
COPY --from=builder /catkin_ws/src   /catkin_ws/src

# 5) Install Python packages
RUN pip3 install --no-cache-dir \
      numpy==1.23.5 \
      mediapipe==0.10.8 \
      tflite-runtime==2.10.0 \
      tensorflow==2.13.0 \
      pyrealsense2==2.55.1.6486

# 6) Create GPU delegate mountpoint (mount at run-time)
#    and non-root user; ignore existing 'video' group
RUN groupadd -g 998 video 2>/dev/null || true \
 && useradd -m -u 1000 -s /bin/bash yunusdanabasDocker \
 && usermod -aG video yunusdanabasDocker

# 7) Source in shell
RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /home/yunusdanabasDocker/.bashrc \
 && echo "source /catkin_ws/devel/setup.bash"  >> /home/yunusdanabasDocker/.bashrc

# 8) Switch to non-root & GUI env
USER yunusdanabasDocker
WORKDIR /home/yunusdanabasDocker
ENV QT_DEBUG_PLUGINS=0 \
    QT_PLUGIN_PATH=/usr/lib/x86_64-linux-gnu/qt5/plugins \
    QT_QPA_PLATFORM=xcb \
    QT_X11_NO_MITSHM=1 \
    DISPLAY=:0
